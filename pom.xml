<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        Paper/Folia build (default):  mvn install
        Spigot build (shades Adventure): mvn install -P spigot
    -->
    <groupId>coolcostupit</groupId>
    <artifactId>openjs</artifactId>
    <version>1.5.1 ALPHA</version>
    <packaging>jar</packaging>
    <name>OpenJS-Plugin</name>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>
    <build>
        <!-- Default finalName (no suffix) used by the Paper/Folia build -->
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <compress>true</compress>
                        <index>true</index>
                    </archive>
                    <outputDirectory>A:\Projects\OpenJS-Plugin\NightlyBuild</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDirectory>A:\Projects\OpenJS-Plugin\NightlyBuild</outputDirectory>
                    <minimizeJar>true</minimizeJar>
                    <relocations>
                        <relocation>
                            <pattern>org.bstats</pattern>
                            <shadedPattern>coolcostupit.openjs.modules.bstats</shadedPattern>
                        </relocation>
                    </relocations>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/**</exclude>
                                <exclude>mozilla/**</exclude>
                                <exclude>changelog.txt</exclude>
                                <exclude>org/openjdk/nashorn/tools/**</exclude>
                            </excludes>
                        </filter>
                        <filter>
                            <artifact>org.openjdk.nashorn:nashorn-core</artifact>
                            <includes>
                                <include>org/openjdk/nashorn/**</include>
                            </includes>
                        </filter>
                    </filters>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
    <repositories>
        <repository>
            <id>dmulloy2-repo</id>
            <url>https://repo.dmulloy2.net/repository/public/</url>
        </repository>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.nashorn</groupId>
            <artifactId>nashorn-core</artifactId>
            <version>15.7</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>23.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>xyz.jpenilla</groupId>
            <artifactId>reflection-remapper</artifactId>
            <version>0.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.folia</groupId>
            <artifactId>folia-api</artifactId>
            <version>1.20.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>spigot</id>
            <build>
                <!-- Appends -spigot to the jar filename -->
                <finalName>${project.artifactId}-${project.version}-spigot</finalName>
                <plugins>
                    <plugin>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputDirectory>A:\Projects\OpenJS-Plugin\NightlyBuild</outputDirectory>
                            <minimizeJar>true</minimizeJar>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>coolcostupit.openjs.modules.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>mozilla/**</exclude>
                                        <exclude>changelog.txt</exclude>
                                        <exclude>org/openjdk/nashorn/tools/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openjdk.nashorn:nashorn-core</artifact>
                                    <includes>
                                        <include>org/openjdk/nashorn/**</include>
                                    </includes>
                                </filter>
                                <!-- Force-include Adventure so minimizeJar doesn't strip it -->
                                <filter>
                                    <artifact>net.kyori:adventure-api</artifact>
                                    <includes>
                                        <include>net/kyori/**</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>net.kyori:adventure-platform-bukkit</artifact>
                                    <includes>
                                        <include>net/kyori/**</include>
                                    </includes>
                                </filter>
                            </filters>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <!-- Adventure API — compile scope so it gets shaded in -->
                <dependency>
                    <groupId>net.kyori</groupId>
                    <artifactId>adventure-api</artifactId>
                    <version>4.17.0</version>
                </dependency>
                <!-- Bukkit platform adapter (sends Adventure components on Spigot) -->
                <dependency>
                    <groupId>net.kyori</groupId>
                    <artifactId>adventure-platform-bukkit</artifactId>
                    <version>4.4.1</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>